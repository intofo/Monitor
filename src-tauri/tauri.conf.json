{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Monitor",
  "version": "0.1.0",
  "identifier": "dev.agentmonitor.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Monitor",
        "width": 1084,
        "height": 779,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "minWidth": 430,
        "minHeight": 325
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "VCENTER",
    "copyright": "©VCENTER.dev"
  }
}
